SELECT
RHA.REQUISITION_NUMBER,
HOU.NAME REQUISITIONING_BU,
RHA.DOCUMENT_STATUS STATUS,
TO_CHAR(RHA.CREATION_DATE,'DD/MM/YYYY') CREATION_DATE,
RHA.CREATED_BY,
RHA.DESCRIPTION,
RLA.LINE_NUMBER LINE,
IUOMTL.UNIT_OF_MEASURE UOM,
RLA.QUANTITY,
RLA.UNIT_PRICE PRICE,
(RLA.QUANTITY*RLA.UNIT_PRICE)AMOUNT,
RLA.DESTINATION_TYPE_CODE DESTINATION_TYPE,
PPN.DISPLAY_NAME BUYER,
EGPCB.CATEGORY_CODE CATEGORY_NAME,
HLA.LOCATION_NAME DELIVER_TO_LOCATION,
HZ.PARTY_NAME SUPPLIER,
ESIB.ITEM_NUMBER,
(GCC.SEGMENT1 || '.' || GCC.SEGMENT2 || '.' || GCC.SEGMENT3 || '.' || GCC.SEGMENT4 || '.' || GCC.SEGMENT5)CHARGE_ACCOUNT
FROM
POR_REQUISITION_HEADERS_ALL RHA,
POR_REQUISITION_LINES_ALL   RLA,
POR_REQ_DISTRIBUTIONS_ALL   RDA,
HR_ALL_ORGANIZATION_UNITS   HOU,
INV_UNITS_OF_MEASURE_B      IUOMB,
INV_UNITS_OF_MEASURE_TL     IUOMTL,
PER_PERSON_NAMES_F_V        PPN,
EGP_CATEGORIES_B            EGPCB,
HR_LOCATIONS_ALL            HLA,
POZ_SUPPLIERS               POS,
HZ_PARTIES                  HZ,
HR_ALL_ORGANIZATION_UNITS   LOC,
HR_ALL_ORGANIZATION_UNITS   LOC1,
EGP_SYSTEM_ITEMS_B          ESIB,
EGP_SYSTEM_ITEMS_TL ESIT,
GL_CODE_COMBINATIONS        GCC
WHERE 1=1
AND RHA.REQUISITION_HEADER_ID       = RLA.REQUISITION_HEADER_ID
AND RLA.REQUISITION_LINE_ID         = RDA.REQUISITION_LINE_ID
AND RHA.REQ_BU_ID                   = HOU.ORGANIZATION_ID
AND GCC.CODE_COMBINATION_ID         = RDA.CODE_COMBINATION_ID
AND RLA.UOM_CODE                    = IUOMB.UOM_CODE
AND IUOMB.UNIT_OF_MEASURE_ID        = IUOMTL.UNIT_OF_MEASURE_ID
AND PPN.PERSON_ID                   = RLA.ASSIGNED_BUYER_ID
AND RLA.CATEGORY_ID                 = EGPCB.CATEGORY_ID
AND HLA.LOCATION_ID                 = RLA.DELIVER_TO_LOCATION_ID
AND POS.VENDOR_ID                   = RLA.VENDOR_ID
AND POS.PARTY_ID                    = HZ.PARTY_ID
AND RLA.DESTINATION_ORGANIZATION_ID = LOC.ORGANIZATION_ID
AND RLA.DESTINATION_ORGANIZATION_ID = LOC1.ORGANIZATION_ID
AND LOC.LOCATION_ID                 = LOC1.LOCATION_ID        
AND RLA.ITEM_ID = ESIT.INVENTORY_ITEM_ID
AND ESIB.INVENTORY_ITEM_ID = ESIT.INVENTORY_ITEM_ID
AND RLA.DESTINATION_ORGANIZATION_ID = ESIB.ORGANIZATION_ID
AND ESIB.ORGANIZATION_ID            = ESIT.ORGANIZATION_ID
AND ESIT.LANGUAGE='US'
AND IUOMTL.LANGUAGE='US'
AND RHA.REQUISITION_NUMBER          = '204145'
